{
  "name": "dealers-choice-poker-ts",
  "version": "0.0.5",
  "description": "Dealer's Choice Poker game made using Phaser and Colyseus, designed for web browsers.",
  "main": "main.ts",
  "scripts": {
    "test": "npx jest",
    "dev": "node log.js dev & webpack-dev-server --config client/webpack/config.dev.js --open",
    "build": "node log.js build & webpack --config client/webpack/config.prod.js",
    "server": "tsx watch server/src/server.ts",
    "loadtest": "tsx server/loadtest/example.ts --room my_room --numClients 2"
  },
  "repository": {
    "type": "git",
    "url": "www.github.com/the-random-encounter/dealers-choice-poker-ts/"
  },
  "keywords": [
    "Poker",
    "Phaser",
    "Colyseus",
    "Dealer's",
    "Choice",
    "Multi-player",
    "Betting"
  ],
  "author": "The Random Encounter",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@colyseus/loadtest": "^0.15.7",
    "@colyseus/testing": "^0.15.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "mocha": "^11.0.1",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.0.1",
    "terser-webpack-plugin": "^5.3.11",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@colyseus/command": "^0.3.1",
